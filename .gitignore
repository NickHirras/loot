# Runtime data (SQLite database and WAL files)
data/
*.db
*.db-wal
*.db-shm

# Local config
/loot.yaml

# Build output
bin/
# The compiled binary at the repo root only — anchored so it does not swallow
# the cmd/loot package directory.
/loot

# Frontend
web/node_modules/
web/dist/*
!web/dist/.gitkeep
# Compiled message functions; generated from web/messages by paraglide-js.
web/src/paraglide/

# Go
*.test
coverage.out
# `go build ./...` inside the translation tool's module leaves its binary here.
/tools/translate/translate

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
/dist/
