{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    // The only JavaScript under src/ is what paraglide-js generates from
    // web/messages, and its per-locale plural code trips noUnusedLocals for a
    // language with a single plural form. Types still flow out of its JSDoc
    // with checkJs off; only error reporting inside those files stops.
    "checkJs": false,
    // svelte-check only type-checks; without this, the generated
    // src/paraglide/*.js files look like emit targets that would overwrite
    // their own inputs.
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte", "vite.config.ts"]
}
