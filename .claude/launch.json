{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "loot",
      "runtimeExecutable": "/opt/homebrew/bin/go",
      "runtimeArgs": [
        "run",
        "./cmd/loot",
        "serve",
        "--dev"
      ],
      "port": 8080
    },
    {
      "name": "loot-demo",
      "runtimeExecutable": "/opt/homebrew/bin/go",
      "runtimeArgs": [
        "run",
        "./cmd/loot",
        "serve",
        "--demo",
        "--listen",
        ":8081"
      ],
      "port": 8081
    },
    {
      "name": "loot-real",
      "runtimeExecutable": "/opt/homebrew/bin/go",
      "runtimeArgs": [
        "run",
        "./cmd/loot",
        "serve",
        "--config",
        "loot.yaml"
      ],
      "port": 8080
    }
  ]
}